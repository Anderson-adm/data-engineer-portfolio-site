---
interface Props { variant?: 'network' | 'lake' | 'event'; hero?: boolean; }
const { variant = 'network', hero = false } = Astro.props;
---
<div class:list={['signal-art', variant, { 'hero-art': hero }]} aria-hidden="true">
  <svg viewBox="0 0 560 380" fill="none">
    <defs>
      <pattern id={`grid-${hero ? 'hero' : variant}`} width="32" height="32" patternUnits="userSpaceOnUse"><path d="M32 0H0v32" stroke="currentColor" stroke-opacity=".12" stroke-width=".7" /></pattern>
      <linearGradient id={`fade-${hero ? 'hero' : variant}`} x1="100" y1="50" x2="450" y2="370" gradientUnits="userSpaceOnUse"><stop stop-color="#a9c986" stop-opacity=".18" /><stop offset="1" stop-color="#a9c986" stop-opacity=".015" /></linearGradient>
    </defs>
    <rect x="24" y="20" width="512" height="340" fill={`url(#grid-${hero ? 'hero' : variant})`} />
    {variant === 'network' && <>
      <path d="m90 232 192-110 188 110-192 111Z" fill={`url(#fade-${hero ? 'hero' : variant})`} stroke="currentColor" stroke-opacity=".3" />
      <path d="m90 200 192-110 188 110-192 111Z" fill="#172222" stroke="currentColor" stroke-opacity=".5" />
      <path d="m90 168 192-110 188 110-192 111Z" fill={`url(#fade-${hero ? 'hero' : variant})`} stroke="currentColor" stroke-opacity=".8" />
      <g stroke="currentColor" stroke-opacity=".45"><path d="m154 132 188 110m-124-147 188 110M154 205 346 95m-128 147L410 132M90 168v64m188 47v64m192-175v64" /></g>
      <g fill="currentColor"><circle cx="282" cy="58" r="4" /><circle cx="90" cy="168" r="4" /><circle cx="470" cy="168" r="4" /><circle cx="278" cy="279" r="4" /><circle cx="278" cy="168" r="6" /><circle cx="342" cy="205" r="3" /><circle cx="218" cy="132" r="3" /></g>
      <path d="M278 153v-36m-16 51h-36m68 0h36m-52 15v36" stroke="currentColor" />
      <g stroke="currentColor" stroke-opacity=".5"><path d="M58 85V61h24m396 245h24v-24M58 289v24h24m396-228h24V61" /></g>
    </>}
    {variant === 'lake' && <>
      {[0, 1, 2, 3].map(i => <g transform={`translate(0 ${i * 39})`}><path d="m135 132 145-69 145 69-145 69Z" fill="#172222" stroke="currentColor" stroke-opacity={.9 - i * .17} /><path d="m135 132 145 69 145-69v17l-145 69-145-69Z" fill="currentColor" fill-opacity=".05" stroke="currentColor" stroke-opacity=".2" /></g>)}
      <path d="M280 28v23m0 274v27M86 185h30m328 0h30" stroke="currentColor" stroke-dasharray="3 5" />
    </>}
    {variant === 'event' && <>
      <circle cx="280" cy="190" r="115" stroke="currentColor" stroke-opacity=".15" /><circle cx="280" cy="190" r="75" stroke="currentColor" stroke-opacity=".3" stroke-dasharray="3 8" />
      <path d="M79 190h122m158 0h122M280 60v63m0 134v63" stroke="currentColor" stroke-opacity=".6" />
      <path d="m272 112 8 11 8-11m72 70 11 8-11 8M188 182l11 8-11 8m84 110 8 11 8-11" stroke="currentColor" />
      <rect x="236" y="146" width="88" height="88" rx="8" fill="#1e2c28" stroke="currentColor" /><path d="m270 170 24 20-24 20" stroke="currentColor" stroke-width="2" />
      {[80, 460].map(x => <rect x={x - 18} y="172" width="36" height="36" rx="4" fill="#172222" stroke="currentColor" />)}
      <circle cx="280" cy="64" r="8" fill="currentColor" /><circle cx="280" cy="318" r="8" fill="#172222" stroke="currentColor" />
    </>}
  </svg>
  {hero && <><span class="art-coordinate coordinate-top">01 / CONEXÕES</span><span class="art-coordinate coordinate-bottom">SISTEMAS → DADOS → DECISÕES</span><span class="art-marker">[ + ]</span></>}
</div>
