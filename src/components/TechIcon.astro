---
import { technologies, type TechnologyName } from '../data/technologies';
import { local } from '../lib/links';
interface Props { name: TechnologyName; label?: boolean; }
const { name, label = false } = Astro.props;
const technology = technologies.find(item => item.name === name)!;
---
<span class:list={['tech-item', { 'with-label': label }]}>
  <span class="tech-tile" title={name === 'CI/CD' ? 'CI/CD · GitHub Actions' : name}><img src={local(`icons/${technology.icon}`)} width="30" height="30" alt={label ? '' : name} loading="eager" /></span>
  {label && <span class="tech-name">{name}</span>}
</span>
