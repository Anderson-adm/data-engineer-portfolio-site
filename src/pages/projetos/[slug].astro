---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import { projects, type Project } from '../../data/projects';
import { local, httpsUrl } from '../../lib/links';
import Icon from '../../components/Icon.astro';
import SignalArt from '../../components/SignalArt.astro';
export const getStaticPaths = (() => projects.map(project => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;
interface Props { project: Project; }
const { project } = Astro.props;
const next = projects[(projects.findIndex(item => item.slug === project.slug) + 1) % projects.length];
---
<Layout title={`${project.title} — Data Portfolio`} description={project.description}>
  <div class="container case-page">
    <a class="back-link" href={local('#projetos')}>← Todos os projetos</a>
    <header class="case-header"><p class="eyebrow">CASE {project.number} / {project.category.toUpperCase()}</p><span class:list={['status', { active: project.active }]}><span></span>{project.status}</span><h1>{project.title}</h1><p class="case-lead">{project.description}</p><ul class="tags" aria-label="Tecnologias previstas">{project.tags.map(tag => <li>{tag}</li>)}</ul></header>
    <div class="case-overview"><div><p class="eyebrow">O PROBLEMA</p><h2>{project.problem}</h2><p>Estudo autoral · {project.active ? 'Em desenvolvimento' : 'Planejado'}</p></div><SignalArt variant={project.visual} /></div>
    <div class="case-body"><aside class="case-index" aria-label="Nesta página"><p class="eyebrow">NESTE CASE</p><a href="#contexto">01 Contexto e objetivos</a><a href="#arquitetura">02 Arquitetura proposta</a><a href="#desafios">03 Desafios técnicos</a><a href="#decisoes">04 Decisões e trade-offs</a><a href="#estado">05 Estado e próximos passos</a></aside><div class="case-sections">
      <section id="contexto"><p class="eyebrow">01 / CONTEXTO</p><h2>O que este projeto busca resolver</h2><p>{project.context}</p><h3>Objetivos do estudo</h3><ul class="objectives">{project.goals.map(goal => <li>{goal}</li>)}</ul></section>
      <section id="arquitetura"><p class="eyebrow">02 / ARQUITETURA PROPOSTA</p><h2>Um desenho em definição</h2><div class="honesty-note"><span class="tiny-square"></span> Proposta de estudo. Não representa uma arquitetura implantada.</div><p>{project.architecture}</p><h3>Tecnologias previstas</h3><ul class="tags">{project.tags.map(tag => <li>{tag}</li>)}</ul><p class="small-copy">A lista indica o direcionamento do projeto. O uso efetivo e as configurações serão documentados conforme a implementação for validada.</p></section>
      <section id="desafios"><p class="eyebrow">03 / DESAFIOS TÉCNICOS</p><h2>As perguntas que orientam o trabalho</h2><div class="challenge-list">{project.challenges.map((challenge, index) => <article><span class="mono">0{index + 1}</span><div><h3>{challenge.title}</h3><p>{challenge.text}</p></div></article>)}</div></section>
      <section id="decisoes"><p class="eyebrow">04 / DECISÕES E TRADE-OFFS</p><h2>Decisões com evidências</h2><p>{project.decisions}</p></section>
      <section id="estado"><p class="eyebrow">05 / ESTADO ATUAL</p><h2>{project.active ? 'Reconstrução em desenvolvimento' : 'Projeto planejado'}</h2><p>{project.next}</p>{httpsUrl(project.github || '') && <a class="text-link" href={httpsUrl(project.github || '')}>Repositório no GitHub <Icon kind="diagonal" /></a>}{httpsUrl(project.documentation || '') && <a class="text-link" href={httpsUrl(project.documentation || '')}>Documentação <Icon kind="diagonal" /></a>}{!httpsUrl(project.github || '') && !httpsUrl(project.documentation || '') && <p class="small-copy">Repositório e documentação pública ainda não estão disponíveis.</p>}</section>
    </div></div>
    <a class="next-case" href={local(`projetos/${next.slug}/`)}><div><span class="eyebrow">CONTINUAR EXPLORANDO / CASE {next.number}</span><h2>{next.title}</h2></div><Icon /></a>
  </div>
</Layout>
