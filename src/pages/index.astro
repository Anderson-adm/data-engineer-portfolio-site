---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import TechIcon from '../components/TechIcon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import workspace from '../assets/data-workspace.png';
import { projects } from '../data/projects';
import { technologyGroups } from '../data/technologies';
import { profile } from '../data/profile';
import { socialLinks, email, resumeUrl } from '../lib/links';
const principles = ['Entender o problema antes da ferramenta.', 'Construir para testar, observar e reprocessar.', 'Explicitar contratos e decisões. Automatizar com propósito.'];
---
<Layout home>
  <div class="home-shell container">
    <section class="intro-panel" aria-labelledby="hero-title">
      <div class="intro-copy">
        <p class="intro-eyebrow"><span></span>{profile.name ? `OLÁ, SOU ${profile.name.toUpperCase()}` : 'ENGENHEIRO DE DADOS · DESDE 2020'}</p>
        <h1 id="hero-title">Dados conectados.<br />Soluções <span>confiáveis.</span></h1>
        <p class="intro-description">Integro sistemas e construo pipelines com Python, SQL e AWS. Engenharia de Software aplicada à confiabilidade dos dados.</p>
        <div class="intro-actions"><a class="button" href="#projetos">Explorar projetos <Icon /></a>{socialLinks.map(link => <a class="text-link" href={link.href}>{link.label} <Icon kind="diagonal" /></a>)}{socialLinks.length === 0 && <a class="text-link" href="#sobre">Sobre mim <Icon kind="diagonal" /></a>}{resumeUrl && <a class="text-link" href={resumeUrl}>Currículo <Icon kind="diagonal" /></a>}</div>
      </div>
      <div class="intro-scene" aria-hidden="true"><Image src={workspace} alt="" widths={[480, 720, 960]} sizes="(max-width: 600px) 100vw, 50vw" format="webp" quality={82} loading="eager" fetchpriority="high" /><div class="scene-label"><span></span> código · dados · café</div></div>
    </section>
    <section class="technology-strip" id="competencias" aria-labelledby="stack-title">
      <h2 class="sr-only" id="stack-title">Tecnologias e ferramentas</h2>
      <div class="technology-groups">{technologyGroups.map(group => <section class="technology-group" aria-labelledby={`stack-${group.id}`}><h3 id={`stack-${group.id}`}>{group.label}</h3><ul class="technology-list">{group.items.map(name => <li><TechIcon name={name} label /></li>)}</ul></section>)}</div>
    </section>
    <section class="selected-projects" id="projetos" aria-labelledby="projects-title"><div class="compact-heading"><h2 id="projects-title">Projetos selecionados<span>.</span></h2><span class="section-kicker">IDEIAS → ENGENHARIA</span></div><div class="projects-grid">{projects.map(project => <ProjectCard project={project} />)}</div></section>
    <div class="about-grid">
      <section class="about-panel" id="sobre" aria-labelledby="about-title"><span class="section-kicker">UM POUCO SOBRE MIM</span><h2 id="about-title">Integração, com engenharia.</h2><p>Engenheiro de Dados com experiência desde 2020 em integrações corporativas, processamento e arquiteturas AWS.</p><div class="capability-chips"><span>Integração de sistemas</span><span>Qualidade de dados</span><span>Arquitetura AWS</span></div></section>
      <section class="approach-panel" id="abordagem" aria-labelledby="approach-title"><span class="section-kicker">DO PROBLEMA À OPERAÇÃO</span><h2 id="approach-title">Como trabalho</h2><ol>{principles.map((principle, index) => <li><span>0{index + 1}</span>{principle}</li>)}</ol></section>
    </div>
    <section class="compact-contact" id="contato" aria-labelledby="contact-title"><div><span class="section-kicker">VAMOS CONECTAR?</span><h2 id="contact-title">Uma boa conversa começa com dados.</h2></div><div class="compact-contact-links">{email && <a class="text-link" href={`mailto:${email}`}>{email} <Icon kind="diagonal" /></a>}{socialLinks.map(link => <a class="text-link" href={link.href}>{link.label}<Icon kind="diagonal" /></a>)}{!email && socialLinks.length === 0 && <p>Canais profissionais em breve.</p>}</div></section>
  </div>
</Layout>
