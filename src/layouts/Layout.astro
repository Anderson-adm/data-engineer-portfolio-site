---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { profile } from '../data/profile';
import { local, httpsUrl, socialLinks } from '../lib/links';
import Icon from '../components/Icon.astro';
interface Props { title?: string; description?: string; home?: boolean; }
const { title = profile.seo.title, description = profile.seo.description, home = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const image = Astro.site ? new URL(local('social.svg'), Astro.site).href : undefined;
const nav = [{ label: 'Projetos', id: 'projetos' }, { label: 'Competências', id: 'competencias' }, { label: 'Sobre', id: 'sobre' }];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101119" />
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={local('favicon.svg')} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" /><meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary" />
    {profile.name && <meta name="author" content={profile.name} />}
    {profile.name && httpsUrl(profile.publicUrl) && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Person', name: profile.name, url: profile.publicUrl, jobTitle: 'Engenheiro de Dados', sameAs: socialLinks.map(link => link.href) }).replace(/</g, '\\u003c')} />}
  </head>
  <body class={home ? 'portfolio-home' : 'portfolio-case'}>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header container">
      <a class="brand" href={local()} aria-label="Data Portfolio — início"><span class="brand-icon"><Icon kind="code" /></span><span>{profile.name || 'data'}<span class="brand-slash"> / </span>{profile.name ? <small>engenharia de dados</small> : 'portfolio'}<span class="brand-dot">.</span></span></a>
      <nav aria-label="Navegação principal">{nav.map(item => <a href={`${home ? '' : local()}#${item.id}`}>{item.label}</a>)}<a class="nav-contact" href={`${home ? '' : local()}#contato`}>Contato <Icon kind="diagonal" /></a></nav>
    </header>
    <main id="conteudo"><slot /></main>
    <footer class="site-footer container"><a class="footer-brand" href={local()}>data <span>/</span> portfolio.</a><span>© {new Date().getFullYear()} · {profile.name || 'Engenharia de Dados'}</span><a href="#conteudo">Voltar ao topo ↑</a></footer>
  </body>
</html>
